{
  "name": "hsl-language-support",
  "displayName": "HSL (Hamilton) Language Support",
  "description": "Base language support for Hamilton Standard Language (HSL)",
  "version": "2.5.6",
  "publisher": "ZacharyMilot",
  "author": "Zachary Milot",
  "repository": {
    "type": "git",
    "url": "https://github.com/zdmilot/VS-Code-Extension-for-HSL.git"
  },
  "bugs": {
    "url": "https://github.com/zdmilot/VS-Code-Extension-for-HSL/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Linters", "Other"],
  "icon": "HSL.png",
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:hsl", "onLanguage:hsl-trace"],
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:checksum && npm run verify:package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:checksum": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-checksum.ps1",
    "build:simulator": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-simulator.ps1",
    "verify:package": "node scripts/verify-package.js",
    "test": "npm run compile && node --test test/hslCore.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "hsl",
        "aliases": ["HSL", "Hamilton Standard Language"],
        "extensions": [".hsl", ".hs_", ".hsi", ".sub"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "hsl-trace",
        "aliases": ["HSL Trace Log", "Hamilton Trace"],
        "extensions": [".trc"],
        "configuration": "./language-configuration-trace.json"
      }
    ],
    "grammars": [
      {
        "language": "hsl",
        "scopeName": "source.hsl",
        "path": "./syntaxes/hsl.tmLanguage.json"
      },
      {
        "language": "hsl-trace",
        "scopeName": "source.hsl-trace",
        "path": "./syntaxes/hsl-trace.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "hsl",
        "path": "./snippets/hsl.code-snippets"
      }
    ],
    "debuggers": [
      {
        "type": "hsl",
        "label": "HSL Simulator",
        "languages": ["hsl"],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the HSL method file to run.",
                "default": "${file}"
              },
              "hamiltonDir": {
                "type": "string",
                "description": "Path to the Hamilton installation directory.",
                "default": "C:\\Program Files (x86)\\Hamilton"
              },
              "verbose": {
                "type": "boolean",
                "description": "Show detailed trace output.",
                "default": true
              },
              "strictSimulation": {
                "type": "boolean",
                "description": "Treat unknown functions and simulated runtime faults as errors.",
                "default": true
              },
              "internalConsoleOptions": {
                "type": "string",
                "enum": ["neverOpen", "openOnFirstSessionStart", "openOnSessionStart"],
                "description": "Controls when the Debug Console panel is opened.",
                "default": "openOnSessionStart"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "hsl",
            "request": "launch",
            "name": "Simulate HSL Method",
            "program": "${file}",
            "internalConsoleOptions": "openOnSessionStart"
          }
        ],
        "configurationSnippets": [
          {
            "label": "HSL: Simulate Method",
            "description": "Simulate an HSL source method without connecting to hardware.",
            "body": {
              "type": "hsl",
              "request": "launch",
              "name": "Simulate HSL Method",
              "program": "\\${file}"
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "hsl.runMethod",
        "title": "Run HSL Method (Hamilton HxRun)",
        "category": "HSL",
        "icon": "$(play)",
        "enablement": "hsl.hamiltonRunAvailable"
      },
      {
        "command": "hsl.debugMethod",
        "title": "Simulate HSL Method (Offline)",
        "category": "HSL",
        "icon": "$(debug-alt)"
      },
      {
        "command": "hsl.openInHamiltonEditor",
        "title": "Open in Hamilton HSL Editor",
        "category": "HSL",
        "enablement": "hsl.hamiltonEditorAvailable"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "hsl.runMethod",
          "when": "(resourceLangId == hsl || resourceExtname == .med) && hsl.hamiltonRunAvailable",
          "group": "navigation@1"
        },
        {
          "command": "hsl.debugMethod",
          "when": "(resourceLangId == hsl || resourceExtname == .med) && hsl.hamiltonRunAvailable",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "hsl.runMethod",
          "when": "(resourceLangId == hsl || resourceExtname == .med) && hsl.hamiltonRunAvailable",
          "group": "navigation@1"
        },
        {
          "command": "hsl.debugMethod",
          "when": "resourceLangId == hsl || resourceExtname == .med",
          "group": "navigation@2"
        },
        {
          "command": "hsl.openInHamiltonEditor",
          "when": "(resourceLangId == hsl || resourceExtname == .med) && hsl.hamiltonEditorAvailable",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "hsl.runMethod",
          "when": "resourceLangId == hsl || resourceExtname == .med",
          "group": "navigation@1"
        },
        {
          "command": "hsl.debugMethod",
          "when": "resourceLangId == hsl || resourceExtname == .med",
          "group": "navigation@2"
        },
        {
          "command": "hsl.openInHamiltonEditor",
          "when": "(resourceLangId == hsl || resourceExtname == .med) && hsl.hamiltonEditorAvailable",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [],
    "customEditors": [
      {
        "viewType": "hsl.methodEditor",
        "displayName": "HSL Method Overview",
        "selector": [
          { "filenamePattern": "*.hsl" },
          { "filenamePattern": "*.hs_" },
          { "filenamePattern": "*.hsi" },
          { "filenamePattern": "*.sub" }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Hamilton HSL",
      "properties": {
        "hsl.hamiltonDir": {
          "type": "string",
          "default": "C:\\Program Files (x86)\\Hamilton",
          "description": "Optional Hamilton installation directory used only for local libraries, the Hamilton editor, and HxRun integration. Offline language support and simulation do not require it."
        },
        "hsl.libraryRoots": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional HSL include roots. Empty uses the standard Library, Methods, demo-method, and Bin folders under hsl.hamiltonDir."
        },
        "hsl.autoSanitizeNonAscii": {
          "type": "boolean",
          "default": false,
          "description": "Replace known non-ASCII characters and remove unsupported characters before saving. Disabled by default because it changes source text."
        },
        "hsl.updateChecksumOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Opt in to Hamilton file validation after saving. Requires the x86 Hamilton security COM component; disabled by default so clean-machine use has no Hamilton dependency."
        }
      }
    },
    "configurationDefaults": {
      "[hsl]": {
        "github.copilot.chat.codeGeneration.instructions": [
          {
            "text": "HSL rules: declare variables at the top of every block; HSL has no C/C++ 'continue' statement, and 'next' is only valid in the error-handling forms 'resume next;' and 'onerror resume next;'; do not use compound assignments such as += or -=; provide matching function declarations and definitions (which may be in companion files); use 'variable' values for '+' concatenation and 'string' values for string member functions; use 'onerror goto Label;', 'onerror goto 0;', or 'onerror resume next;' for error handling; and declare loop variables before the for statement."
          }
        ]
      }
    }
  }
}
